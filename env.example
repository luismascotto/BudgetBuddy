# BudgetBuddy Configuration
# Copy this file to .env and set your own values

# Database (REQUIRED)
# For local PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/budgetbuddy
# For Docker setup, this is set automatically in docker-compose.dev.yml

# Authentication credentials (optional - defaults shown)
BUDGET_USERNAME=admin
BUDGET_PASSWORD=budget123

# Session secret (change this in production!)
BUDGET_SESSION_SECRET=budget-buddy-secret-key-2024

# Node environment
NODE_ENV=development
